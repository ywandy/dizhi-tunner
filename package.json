{
  "name": "dizhi-tunner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:mobile-h5": "MOBILE_H5_BUILD=1 vite build",
    "mobile:pack": "pnpm build:mobile-h5 && node scripts/pack-mobile-h5.mjs",
    "mobile:start": "pnpm --filter dizhi-tunner-mobile start",
    "mobile:ios:dev": "EXPO_PUBLIC_WEBVIEW_DEV_URL=${EXPO_PUBLIC_WEBVIEW_DEV_URL:-http://localhost:5173} pnpm --filter dizhi-tunner-mobile ios",
    "mobile:ios": "pnpm mobile:pack && EXPO_PUBLIC_WEBVIEW_DEV_URL= pnpm --filter dizhi-tunner-mobile ios",
    "mobile:android": "pnpm mobile:pack && EXPO_PUBLIC_WEBVIEW_DEV_URL= pnpm --filter dizhi-tunner-mobile android",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tailwindcss/vite": "^4.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "pitchy": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.27.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wrangler": "3.90.0"
  }
}
